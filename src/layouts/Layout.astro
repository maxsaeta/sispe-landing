---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --blue: #006CCE;
    --blue-dark: #0052A3;
    --bg-light: #BEE1FF;
    --bg-page: #f5f8fc;
    --text-dark: #505050;
    --white: #ffffff;
    --shadow: 0 4px 24px rgba(0, 108, 206, 0.10);
    --radius: 12px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', sans-serif;
    color: var(--text-dark);
    background: var(--bg-page);
    line-height: 1.6;
  }
</style>
